# ============================================================
# Guará-Notes — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# ⚠️  NUNCA faça commit do .env em produção.
# ============================================================

# --- Banco de dados Postgres ---
POSTGRES_USER=guaranotes
POSTGRES_PASSWORD=guaranotes_secret
POSTGRES_DB=guaranotes

# --- Segurança ---
# Gere um segredo forte em produção: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_please_change_in_production

# --- CORS ---
# Lista separada por vírgulas das origens permitidas
# Em produção, coloque seu domínio: https://notes.meusite.com
CORS_ORIGINS=http://localhost:5757,http://127.0.0.1:5757

# --- Provider de IA ---
# Opções: local | gemini | claude
# 'local' usa o Ollama (sem custo, roda na sua máquina/VPS)
AI_PROVIDER=local

# --- Ollama (usado quando AI_PROVIDER=local) ---
OLLAMA_URL=http://ollama:11434
# Modelo de embeddings (para vetorizar notas)
OLLAMA_MODEL_EMBED=nomic-embed-text
# Modelo de chat (companion de IA + ghost writer)
# CPU: llama3.2:3b (leve, ~2GB)
# GPU moderada: llama3.1:8b (~5GB VRAM)
# GPU alta: llama3.1:70b (não recomendado em self-hosted)
OLLAMA_MODEL_CHAT=llama3.2:3b

# --- Gemini API (usado quando AI_PROVIDER=gemini) ---
GEMINI_API_KEY=

# --- Anthropic/Claude API (usado quando AI_PROVIDER=claude) ---
CLAUDE_API_KEY=

# --- Tuning do pipeline de IA ---
# Distância coseno máxima para considerar link semântico (0=idêntico, 1=oposto)
SEMANTIC_THRESHOLD=0.35
# Máximo de links semânticos por nota
SEMANTIC_TOP_K=8
# Máximo de trechos de notas injetados no contexto RAG
RAG_TOP_K=5
